---
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import HeroSection from "@/components/HeroSection";
import ExperienceSection from "@/components/ExperienceSection";
import SkillsSection from "@/components/SkillsSection";
import ResearchHighlights from "@/components/ResearchHighlights";

import EducationSection from "@/components/EducationSection";
import Footer from "@/components/Footer";
import ChatBubble from "@/components/ChatBubble";
---

<Layout>
  <GlassHeader client:only="react" />
  <main class="min-h-screen">
    <HeroSection client:only="react" />
    <ResearchHighlights client:only="react" />
    <ExperienceSection client:only="react" />
    <EducationSection client:only="react" />
    <SkillsSection client:only="react" />
  
  </main>
  <Footer client:only="react" />
  <ChatBubble client:only="react" />
</Layout>

<script>
  // Handle hash navigation after page load
  function handleHashNavigation() {
    const hash = window.location.hash;
    if (hash) {
      // Wait for React components to render
      setTimeout(() => {
        const element = document.querySelector(hash);
        if (element) {
          element.scrollIntoView({ 
            behavior: 'smooth',
            block: 'start'
          });
        }
      }, 100);
    }
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleHashNavigation);
  } else {
    handleHashNavigation();
  }

  // Also handle hash changes (in case user navigates with hash)
  window.addEventListener('hashchange', handleHashNavigation);
</script>
